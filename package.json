{
  "name": "dokumaster-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ssot-check": "node scripts/ssot-compliance-scanner.cjs && node scripts/billing-routing-proof.cjs",
    "test:golden": "vitest run --passWithNoTests src/test/golden-master/golden-master.test.ts",
    "test:property": "vitest run --passWithNoTests src/test/property-tests.test.ts",
    "test:whisper": "vitest run --passWithNoTests src/test/ugly-whisper.test.ts",
    "test:fuzzer": "vitest run src/test/conflict-fuzzer.test.ts",
    "test:billing": "vitest run src/test/billing-completeness.test.ts",
    "test:integrity": "vitest run src/test/output-integrity.test.ts",
    "test:golden-output": "vitest run --passWithNoTests src/test/golden-outputs/golden-output.test.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:v7": "npx playwright test e2e/v7-ui-wiring.spec.ts",
    "test:e2e:ci": "node scripts/e2e-ci-runner.cjs",
    "test:e2e:prod": "node scripts/e2e-prod-runner.cjs",
    "test:v7:unit": "vitest run src/docudent/v7/__tests__/ --reporter=verbose",
    "test:v7:e2e": "playwright test -c src/docudent/v7/__e2e__/playwright.config.ts",
    "test:v7:realcases": "playwright test -c src/docudent/v7/__e2e__/playwright.config.ts --grep REALCASES",
    "test:v7:merge": "npm run test:v7:unit && npm run test:v7:realcases",
    "test:v7": "npm run test:v7:unit",
    "e2e:v7": "playwright test -c src/docudent/v7/__e2e__/playwright.config.ts v7-multiinstance-2teeth.e2e.spec.ts v7-multiinstance-questions-2teeth.e2e.spec.ts --reporter=list",
    "e2e:v7:ui": "playwright test -c src/docudent/v7/__e2e__/playwright.config.ts v7-multiinstance-2teeth.e2e.spec.ts v7-multiinstance-questions-2teeth.e2e.spec.ts --ui",
    "e2e:v7:live": "VITE_V7_E2E_LIVE=1 playwright test -c src/docudent/v7/__e2e__/playwright.config.ts v7-live-sanity.e2e.spec.ts --reporter=list",
    "e2e:v7:live:ui": "VITE_V7_E2E_LIVE=1 playwright test -c src/docudent/v7/__e2e__/playwright.config.ts v7-live-sanity.e2e.spec.ts --ui",
    "test:v6-integration": "vitest run --passWithNoTests src/test/v6-pipeline.integration.test.ts",
    "audit:v6-ssot": "node scripts/v6-ssot-pipeline-audit.cjs",
    "red-team": "node scripts/red-team-test.cjs",
    "proof-pack": "npm run ssot-check && npm run test:golden && npm run test:property && npm run test:whisper && npm run test:fuzzer && npm run test:billing && npm run test:integrity && npm run test:golden-output && npm run test:v6-integration && npm run audit:v6-ssot",
    "proof-pack:full": "npm run proof-pack && npm run test:e2e:ci",
    "repro:replay": "npx ts-node scripts/repro/replayV10Repro.ts",
    "repro:compare": "npx ts-node scripts/repro/compareUiReproWithReplay.ts",
    "v10:reality-check": "node --import tsx scripts/v10/reality-check.ts",
    "atlas:refresh": "node --import tsx scripts/systemAtlas/refresh.ts",
    "atlas:check": "node --import tsx scripts/systemAtlas/check.ts",
    "doctor:online": "node --import tsx scripts/doctor/checkOnlineDeps.ts",
    "kb:seed:firestore": "node --import tsx scripts/firestore/seedTreatmentKb.ts",
    "settings:seed:fictional-practice": "node --import tsx scripts/firestore/seedFictionalPracticeV10.ts",
    "v10:kb-parity": "node --import tsx scripts/firestore/checkTreatmentKbParity.ts --strict --verbose",
    "v10:mvp-check": "node --import tsx scripts/v10/mvp-check.ts",
    "v10:auth-diagnostics": "node --import tsx scripts/v10/checkFirebaseAuthReadiness.ts",
    "v10:callable-diagnostics": "node --import tsx scripts/v10/checkCallableLlmGateways.ts",
    "v10:preanalysis-readiness": "node --import tsx scripts/v10/runV10PreanalysisReadinessPack.ts",
    "v10:preanalysis-readiness:strict": "DOCUDENT_READINESS_STRICT=1 DOCUDENT_READINESS_REQUIRE_PASSWORD=1 DOCUDENT_READINESS_REQUIRE_CALLABLES=1 npm run v10:preanalysis-readiness",
    "v10:preanalysis-readiness:full": "DOCUDENT_READINESS_STRICT=1 DOCUDENT_READINESS_REQUIRE_PASSWORD=1 DOCUDENT_READINESS_REQUIRE_CALLABLES=1 DOCUDENT_READINESS_INCLUDE_HOSTED_GATE=1 npm run v10:preanalysis-readiness",
    "v10:mvp-smoke": "npx vitest run src/docudent/__tests__/gates/gate-mvp-smoke-runner.test.ts",
    "v10:practice-check": "node --import tsx scripts/v10/practice-check.ts",
    "v10:practice-check:full": "npm run v10:practice-check && npm run v10:documentation-fidelity-audit:fliessend20",
    "v10:practice-check:online-llm": "DOCUDENT_REQUIRE_LLM_PATH=1 npm run doctor:online -- --verbose && npm run v10:preanalysis-readiness:strict && npm run e2e:v10:hosted-preanalysis-gate && DOCUDENT_REQUIRE_LLM_PATH=1 npm run v10:documentation-fidelity-audit:fliessend20:llm && DOCUDENT_REQUIRE_LLM_PATH=1 npm run v10:real-dictation-check",
    "e2e:v10:insurance": "npx playwright test -c playwright.v10.config.ts v10-insurance-billing.e2e.spec.ts",
    "e2e:v10:practice": "npx playwright test src/docudent/__tests__/e2e/v10.practice.e2e.spec.ts",
    "e2e:v10:wiring": "npx playwright test e2e/v10-wiring.e2e.spec.ts",
    "e2e:v10:hosted-auth-gate": "node --import tsx scripts/v10/runHostedAuthGate.ts",
    "e2e:v10:hosted-preanalysis-gate": "node --import tsx scripts/v10/runHostedPreanalysisGate.ts",
    "e2e:v10:hosted-auth-confirm-audit": "HOSTED_GATE_GREP='S12 - PKV Kronenpräparation mit Confirm-Pfad' node --import tsx scripts/v10/runHostedAuthGate.ts",
    "e2e:v10:option-wiring": "npx playwright test e2e/v10-option-response-wiring.e2e.spec.ts",
    "e2e:v10:praxis16": "npx playwright test e2e/v10-praxis-16.e2e.spec.ts",
    "e2e:v10:endo6": "npx playwright test e2e/v10-endo-6.e2e.spec.ts",
    "e2e:v10:endo16": "npx playwright test e2e/v10-endo-6.e2e.spec.ts",
    "e2e:full": "npm run build && npm run v10:practice-check:full && npx vitest run gate-v10-medical-e2e-v2 && npm run e2e:v10:wiring",
    "v10:scenario-run": "node --import tsx scripts/v10/runV10ScenarioRun.ts",
    "v10:scenario-run:endo": "node --import tsx scripts/v10/runV10ScenarioRun.ts --file scenarios.v10.endo.json",
    "v10:scenario-run:extraction": "node --import tsx scripts/v10/runV10ScenarioRun.ts --file scenarios.v10.extraction.json",
    "v10:scenario-run:multitreatment": "node --import tsx scripts/v10/runV10MultiTreatmentScenarioRun.ts --file scenarios.v10.multitreatment.json",
    "v10:extraction-benchmark": "node --import tsx scripts/v10/runV10ExtractionBenchmark.ts --file scripts/v10/scenarios.v10.extraction-benchmark.longprosa20.json --out-dir __reports__/llm-extraction-benchmark --require-llm-extraction",
    "v10:explain-run": "node --import tsx scripts/v10/explain-run.ts",
    "v10:medical-scenario-run": "node --import tsx scripts/v10/runV10MedicalScenarioRun.ts",
    "v10:medical-scenario-run:firestore": "node --import tsx scripts/v10/runV10MedicalScenarioRunWithFirestoreSettings.ts",
    "v10:medical-scenario-run:endo": "node --import tsx scripts/v10/runV10MedicalScenarioRun.ts --file scripts/v10/scenarios.v10.endo.medical.json",
    "v10:medical-scenario-run:extraction": "node --import tsx scripts/v10/runV10MedicalScenarioRun.ts --file scripts/v10/scenarios.v10.extraction.medical.json",
    "v10:medical-scenario-run:pzr": "node --import tsx scripts/v10/runV10MedicalScenarioRun.ts --file scripts/v10/scenarios.v10.pzr.medical.json",
    "v10:medical-scenario-run:crown_prep": "node --import tsx scripts/v10/runV10MedicalScenarioRun.ts --file scripts/v10/scenarios.v10.crown_prep.medical.json",
    "v10:real-dictation-check": "node --import tsx scripts/v10/runV10RealDictationCheck.ts",
    "v10:documentation-fidelity-audit": "node --import tsx scripts/v10/runV10DocumentationFidelityAudit.ts",
    "v10:documentation-fidelity-audit:fliessend20": "npm run v10:documentation-fidelity-audit -- --file scripts/v10/scenarios.v10.realworld.fliessend20.json --strict-warnings --disable-firestore-kb",
    "v10:documentation-fidelity-audit:fliessend20:llm": "npm run v10:documentation-fidelity-audit -- --file scripts/v10/scenarios.v10.realworld.fliessend20.json --strict-warnings --require-llm-extraction --disable-firestore-kb",
    "v10:final-audit": "npm run doctor:online -- --verbose && npm run v10:kb-parity && npm test -- --run src/docudent/v10/__tests__/gates && npm run v10:medical-scenario-run -- --file scripts/v10/scenarios.v10.realworld.medical.json && npm run v10:real-dictation-check && npm run v10:documentation-fidelity-audit:fliessend20",
    "v10:final-audit:online-llm": "DOCUDENT_REQUIRE_LLM_PATH=1 npm run doctor:online -- --verbose && npm run v10:preanalysis-readiness:strict && npm run e2e:v10:hosted-preanalysis-gate && npm run v10:kb-parity && npm test -- --run src/docudent/v10/__tests__/gates && npm run v10:medical-scenario-run -- --file scripts/v10/scenarios.v10.realworld.medical.json && DOCUDENT_REQUIRE_LLM_PATH=1 npm run v10:real-dictation-check && DOCUDENT_REQUIRE_LLM_PATH=1 npm run v10:documentation-fidelity-audit:fliessend20:llm",
    "v10:gate:online-llm": "npm run v10:final-audit:online-llm",
    "v10:final-audit:full": "npm run v10:final-audit && npm run e2e:v10:praxis16 && npm run e2e:v10:endo6",
    "v10:audit:consolidated": "node --import tsx scripts/v10/consolidated-audit.ts",
    "v10:audit:release": "DOCUDENT_AUDIT_INCLUDE_HOSTED_AUTH=1 node --import tsx scripts/v10/consolidated-audit.ts",
    "v10:audit:release:preanalysis": "DOCUDENT_AUDIT_INCLUDE_PREANALYSIS_READINESS=1 DOCUDENT_AUDIT_INCLUDE_HOSTED_PREANALYSIS=1 node --import tsx scripts/v10/consolidated-audit.ts",
    "e2e:v10:questions-contract": "VITE_E2E_BYPASS_AUTH=1 npx playwright test e2e/v10-questions-contract.e2e.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@heroicons/react": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/lodash": "^4.17.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.3.0",
    "framer-motion": "^11.0.8",
    "jsdom": "^27.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "openai": "^4.28.4",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.2",
    "react-type-animation": "^3.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-check": "^4.4.0",
    "postcss": "^8.4.35",
    "postcss-import": "^16.0.1",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vitest": "^1.5.0",
    "tsx": "^4.19.2"
  }
}

{
  "name": "dokumaster-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ssot-check": "node scripts/ssot-compliance-scanner.cjs && node scripts/billing-routing-proof.cjs",
    "test:golden": "vitest run src/test/golden-master/golden-master.test.ts",
    "test:property": "vitest run src/test/property-tests.test.ts",
    "test:whisper": "vitest run src/test/ugly-whisper.test.ts",
    "test:fuzzer": "vitest run src/test/conflict-fuzzer.test.ts",
    "test:billing": "vitest run src/test/billing-completeness.test.ts",
    "test:integrity": "vitest run src/test/output-integrity.test.ts",
    "test:golden-output": "vitest run src/test/golden-outputs/golden-output.test.ts",
    "test:e2e": "npx playwright test e2e/smoke.spec.ts",
    "test:e2e:ci": "node scripts/e2e-ci-runner.cjs",
    "test:v6-integration": "vitest run src/test/v6-pipeline.integration.test.ts",
    "audit:v6-ssot": "node scripts/v6-ssot-pipeline-audit.cjs",
    "red-team": "node scripts/red-team-test.cjs",
    "proof-pack": "npm run ssot-check && npm run test:golden && npm run test:property && npm run test:whisper && npm run test:fuzzer && npm run test:billing && npm run test:integrity && npm run test:golden-output && npm run test:v6-integration && npm run audit:v6-ssot",
    "proof-pack:full": "npm run proof-pack && npm run test:e2e:ci"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@heroicons/react": "^2.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/lodash": "^4.17.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.3.0",
    "framer-motion": "^11.0.8",
    "jsdom": "^27.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "openai": "^4.28.4",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.2",
    "react-type-animation": "^3.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-check": "^4.4.0",
    "postcss": "^8.4.35",
    "postcss-import": "^16.0.1",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vitest": "^1.5.0"
  }
}
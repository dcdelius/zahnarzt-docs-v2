{
    "_meta": {
        "schema": "docudent.askbackTemplates.v1",
        "version": "1.0.0",
        "created": "2025-12-14",
        "source": [
            "fz_rules_v1.json",
            "ze_bel_cases_v1_imported.json"
        ],
        "notes": [
            "Templates derived from INCONCLUSIVE rule evaluations",
            "Templates for Multi-BK/Multi-FZ warn cases",
            "Writeback fields extend case schema where applicable"
        ]
    },
    "templates": [
        {
            "templateId": "ASK_FZ_7_1_ZAHNLOS_CONFIRM",
            "ruleId": "FZ_7.1_ONLY_ZAHNLOS",
            "severity": "error",
            "trigger": {
                "type": "missingField",
                "whenFzCodesInclude": [
                    "FZ_7.1"
                ],
                "field": "zahnlos"
            },
            "question": {
                "de": "Ist der Kiefer für die geplante Versorgung vollständig zahnlos?",
                "shortDe": "Kiefer zahnlos?"
            },
            "expectedAnswer": {
                "type": "boolean",
                "trueMeans": "zahnlos",
                "falseMeans": "nicht zahnlos"
            },
            "writeback": {
                "setCaseField": "zahnlos",
                "valueFromAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_04",
                "ruleMessage": "FZ 7.1 (Totalprothese) darf nur bei vollständig zahnlosem Kiefer abgerechnet werden"
            }
        },
        {
            "templateId": "ASK_FZ_3_2A_KIEFER",
            "ruleId": "FZ_3.2A_VERBLENDBEREICH_ONLY",
            "severity": "error",
            "trigger": {
                "type": "missingField",
                "whenFzCodesInclude": [
                    "FZ_3.2a"
                ],
                "field": "kiefer"
            },
            "question": {
                "de": "In welchem Kiefer werden die Teleskopkronen eingesetzt?",
                "shortDe": "Kiefer (OK/UK)?"
            },
            "expectedAnswer": {
                "type": "enum",
                "options": [
                    "OK",
                    "UK"
                ],
                "labels": {
                    "OK": "Oberkiefer",
                    "UK": "Unterkiefer"
                }
            },
            "writeback": {
                "setCaseField": "kiefer",
                "valueFromAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_03",
                "ruleMessage": "FZ 3.2a nur für Teleskopkronen im Verblendbereich (OK: 15-25, UK: 34-44)"
            }
        },
        {
            "templateId": "ASK_FZ_3_2A_TEETH_LIST",
            "ruleId": "FZ_3.2A_VERBLENDBEREICH_ONLY",
            "severity": "error",
            "trigger": {
                "type": "missingField",
                "whenFzCodesInclude": [
                    "FZ_3.2a"
                ],
                "field": "teeth",
                "requiresField": "kiefer"
            },
            "question": {
                "de": "Welche Zähne werden mit Teleskopkronen versorgt? (Bitte Zahnnummern eingeben)",
                "shortDe": "Teleskop-Zähne?"
            },
            "expectedAnswer": {
                "type": "stringArray",
                "itemPattern": "^[1-8][1-8]$",
                "minItems": 1,
                "maxItems": 4,
                "examples": [
                    "33",
                    "43"
                ]
            },
            "writeback": {
                "setCaseField": "teeth",
                "valueFromAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_03",
                "ruleMessage": "Teleskopkronen müssen im Verblendbereich liegen"
            }
        },
        {
            "templateId": "ASK_FZ_1_5_REQUIRES_KRONE",
            "ruleId": "FZ_1.5_REQUIRES_FZ_1.1",
            "severity": "error",
            "trigger": {
                "type": "missingCode",
                "whenFzCodesInclude": [
                    "FZ_1.5"
                ],
                "missingCode": "FZ_1.1"
            },
            "question": {
                "de": "FZ 1.5 (Stiftaufbau) wurde ohne FZ 1.1 (Krone) angegeben. Ist zusätzlich eine Krone geplant oder abgerechnet?",
                "shortDe": "Krone (FZ 1.1) dabei?"
            },
            "expectedAnswer": {
                "type": "boolean",
                "trueMeans": "FZ 1.1 wird hinzugefügt",
                "falseMeans": "FZ 1.5 ohne Krone (Fehler)"
            },
            "writeback": {
                "addFzCode": "FZ_1.1",
                "onlyIfAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_01",
                "ruleMessage": "FZ 1.5 (Stiftaufbau) darf nur zusammen mit FZ 1.1 (Krone) abgerechnet werden"
            }
        },
        {
            "templateId": "ASK_BK6_MULTI_FZ_DOCUMENTED",
            "ruleId": "BK6_REPAIR_MULTI_FZ_COMBO",
            "severity": "warn",
            "trigger": {
                "type": "complexCase",
                "when": {
                    "befundklasse": "6",
                    "minBk6Codes": 2
                }
            },
            "question": {
                "de": "Es liegen mehrere FZ aus BK6 vor (z.B. Unterfütterung + Bruchreparatur + Zahnersatz). Wurde dies als ein zusammenhängender Reparaturvorgang dokumentiert?",
                "shortDe": "Kombinierte Reparatur dokumentiert?"
            },
            "expectedAnswer": {
                "type": "enum",
                "options": [
                    "yes_documented",
                    "yes_not_documented",
                    "no_separate_cases"
                ],
                "labels": {
                    "yes_documented": "Ja, als ein Vorgang dokumentiert",
                    "yes_not_documented": "Ja, aber nicht explizit dokumentiert",
                    "no_separate_cases": "Nein, separate Reparaturfälle"
                }
            },
            "writeback": {
                "setCaseField": "bk6ComboStatus",
                "valueFromAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_12",
                "ruleMessage": "Multi-FZ bei komplexer Reparatur: Kombination Unterfütterung + Zahnersatz + Bruch"
            }
        },
        {
            "templateId": "ASK_MULTI_BK_TOOTH_MAPPING",
            "ruleId": "MULTI_BK_KOMBI_VERSORGUNG",
            "severity": "warn",
            "trigger": {
                "type": "complexCase",
                "when": {
                    "minDistinctBK": 2
                }
            },
            "question": {
                "de": "Diese Versorgung umfasst mehrere Befundklassen. Bitte ordnen Sie die FZ-Codes den jeweiligen Zähnen zu, um Doppelzählung auszuschließen.",
                "shortDe": "Zahn-Zuordnung pro FZ?"
            },
            "expectedAnswer": {
                "type": "object",
                "schema": {
                    "description": "Mapping von FZ-Code zu Zahnliste",
                    "example": {
                        "FZ_1.1": [
                            "34",
                            "36"
                        ],
                        "FZ_2.1": [
                            "35"
                        ],
                        "FZ_3.1": [
                            "37",
                            "38",
                            "47",
                            "48"
                        ]
                    }
                }
            },
            "writeback": {
                "setCaseField": "fzToTeethMap",
                "valueFromAnswer": true
            },
            "evidence": {
                "exampleCaseId": "CASE_06",
                "ruleMessage": "FZ aus unterschiedlichen Befundklassen: Prüfe Doppelzählung von Zähnen"
            }
        },
        {
            "templateId": "ASK_FZ_6_8_UNTERFUETTERUNG_TYPE",
            "ruleId": "FZ_6.8_UNTERFUETTERUNG_BEL_8060",
            "severity": "warn",
            "trigger": {
                "type": "fzCodePresent",
                "whenFzCodesInclude": [
                    "FZ_6.8"
                ]
            },
            "question": {
                "de": "Handelt es sich um eine indirekte (Labor) oder direkte (chairside) Unterfütterung?",
                "shortDe": "Unterfütterung indirekt/direkt?"
            },
            "expectedAnswer": {
                "type": "enum",
                "options": [
                    "indirect_lab",
                    "direct_chairside"
                ],
                "labels": {
                    "indirect_lab": "Indirekt (über Labor, BEL 8060)",
                    "direct_chairside": "Direkt (am Stuhl, FZ 6.9 prüfen)"
                }
            },
            "writeback": {
                "setCaseField": "unterfuetterungType",
                "valueFromAnswer": true,
                "suggestFzChange": {
                    "ifAnswer": "direct_chairside",
                    "suggestReplace": {
                        "from": "FZ_6.8",
                        "to": "FZ_6.9"
                    }
                }
            },
            "evidence": {
                "exampleCaseId": "CASE_10",
                "ruleMessage": "Bei FZ 6.8 (Unterfütterung) sollte BEL 8060 im Laborauftrag enthalten sein"
            }
        }
    ]
}
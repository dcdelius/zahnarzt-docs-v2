{
  "_meta": {
    "id": "crown_prep_template",
    "version": "2026-02-v1",
    "description": "Output-Template fuer Kronenpraeparation. Layout/Slots only."
  },
  "sections": [
    {
      "id": "header",
      "label": "Uebersicht",
      "format": "inline",
      "slots": ["{behandlung}", "{tooth}"],
      "separator": " | "
    },
    {
      "id": "befund",
      "label": "Befund",
      "format": "prose"
    },
    {
      "id": "behandlung",
      "label": "Behandlungsablauf",
      "format": "prose",
      "source": "chips",
      "slotRule": {
        "phases": ["vorbereitung", "anaesthesie", "behandlung", "nachsorge"],
        "proseAllowed": true
      },
      "connectorSource": "phrasebank.behandlung"
    },
    {
      "id": "leistungen",
      "label": "Durchgefuehrte Leistungen",
      "format": "bullets",
      "source": "chips",
      "slotRule": {
        "phases": ["vorbereitung", "anaesthesie", "behandlung", "nachsorge"],
        "hasBilling": true
      },
      "maxBullets": 12
    },
    {
      "id": "abrechnung",
      "label": "Abrechnung",
      "format": "billing",
      "source": "billingDetails"
    },
    {
      "id": "hinweise",
      "label": "Hinweise",
      "format": "prose",
      "source": "disclosures",
      "disclosureIds": ["postop_standard"]
    }
  ],
  "dedupeRules": {
    "byChipId": [],
    "byCategory": []
  },
  "phrasebank": {
    "behandlung": {
      "start": ["Zunaechst"],
      "middle": ["Anschliessend"],
      "end": ["Abschliessend"]
    }
  },
  "textLengthPolicy": {
    "kurz": {
      "snippetKey": "kurz",
      "maxSentencesPerChip": 1
    },
    "mittel": {
      "snippetKey": "mittel",
      "maxSentencesPerChip": 2
    },
    "lang": {
      "snippetKey": "lang",
      "maxSentencesPerChip": 3
    }
  }
}

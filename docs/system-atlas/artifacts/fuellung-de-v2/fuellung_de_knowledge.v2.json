    },
    "edge_cases": [
        {
            "id": "ec1_bulkfill_exception",
            "scenario": "Bulk-Fill bei GKV Regelversorgung",
            "handling": "Nur bei dokumentierter Ausnahme (z.B. tiefe Kavität, Kind, schwierige Kooperation)",
            "required_documentation": "Begründung im Freitext"
        },
        {
            "id": "ec2_anterior_vs_posterior",
            "scenario": "Frontzahn vs Seitenzahn",
            "handling": "Frontzahn: Komposit ist Regelversorgung auch bei GKV; keine self-adhesive Pflicht"
        },
        {
            "id": "ec3_moisture_control",
            "scenario": "Schwierige Trockenlegung (z.B. distale UK-Karies)",
            "handling": "Kofferdam empfohlen; bei Unmöglichkeit: self-adhesive oder mehrzeitig"
        },
        {
            "id": "ec4_deep_caries_no_protection",
            "scenario": "Tiefe Karies ohne Pulpaschutz",
            "handling": "Nur bei Bulk-Fill mit Bioaktivität oder bewusster Entscheidung (dokumentieren)"
        },
        {
            "id": "ec5_subgingival_margin",
            "scenario": "Subgingivaler Kavitätenrand",
            "handling": "Erhöht Feuchtigkeitsrisiko; Kofferdam oder Split-Dam; evtl. GIZ-Schicht gingival"
        },
        {
            "id": "ec6_pediatric_cooperation",
            "scenario": "Kindliche Kooperationsschwierigkeiten",
            "handling": "Bulk-Fill oder GIZ bevorzugt; Kofferdam wenn möglich"
        },
        {
            "id": "ec7_pregnancy_lactation",
            "scenario": "Schwangerschaft/Stillzeit",
            "handling": "Keine Amalgam-Relevanz mehr (ban); Komposit unbedenklich"
        }
    ],
    "hard_rules": [
        {
            "id": "r1_no_billing_hardcode",
            "rule": "Medical KB/Frontend darf KEINE Billing-Positionen direkt enthalten. Nur Chips setzen."
        },
        {
            "id": "r2_chip_per_answer",
            "rule": "Jede Askback-Antwort MUSS 1-2 Chips setzen. Keine 'informational only' Antworten."
        },
        {
            "id": "r3_no_test_tricks",
            "rule": "Keine quarantine, skip, delete, allowlist um Tests grün zu machen."
        }
    ]
}
    "forbidden_derivations": [
        {
            "id": "fd01",
            "forbidden": "Aus 'Komposit' automatisch 'Adhäsiv: ja' ableiten",
            "reason": "Muss explizit bestätigt werden (abrechnungsrelevant)"
        },
        {
            "id": "fd02",
            "forbidden": "Aus 'GKV' automatisch 'self-adhesive' ableiten",
            "reason": "Mehrkosten-Option muss berücksichtigt werden"
        },
        {
            "id": "fd03",
            "forbidden": "Aus 'tief' automatisch 'Pulpaschutz: ja' ableiten",
            "reason": "Behandler-Entscheidung"
        },
        {
            "id": "fd04",
            "forbidden": "Aus 'Kofferdam nicht erwähnt' automatisch 'relative' ableiten",
            "reason": "Askback nötig bei Adhäsiv"
        },
        {
            "id": "fd05",
            "forbidden": "Billing-Position aus Material ableiten",
            "reason": "Muss via Chip → SSOT → Catalog laufen"
        }
    ],
    "edge_cases": [
        {
            "id": "ec01_bulkfill_pediatric",
            "scenario": "Kind + GKV-Regel + Bulk-Fill",
            "handling": "Ausnahme-Chip setzen + Begründung dokumentieren"
        },
        {
            "id": "ec02_anterior_gkv",
            "scenario": "Frontzahn + GKV-Regel + Komposit",
            "handling": "Erlaubt ohne Mehrkosten (Ästhetikzone)"
        },
        {
            "id": "ec03_subgingival_difficult",
            "scenario": "Subgingivaler Rand + schwierige Feuchtigkeit",
            "handling": "Kofferdam empfohlen, Split-Dam möglich"
        },
        {
            "id": "ec04_deep_no_liner",
            "scenario": "Tiefe Karies ohne Liner/Base",
            "handling": "Nur bei Bulk-Fill mit Bioaktivität oder bewusster Entscheidung"
        }
    ]

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "combinability_kb.schema.json",
    "title": "Combinability KB (Compiler Output)",
    "description": "Executable knowledge base for runtime combinability checking",
    "type": "object",
    "required": [
        "_meta",
        "rules"
    ],
    "properties": {
        "_meta": {
            "type": "object",
            "required": [
                "version",
                "generatedAt",
                "ruleCount",
                "hash"
            ],
            "properties": {
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "generatedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "sourceFile": {
                    "type": "string"
                },
                "ruleCount": {
                    "type": "integer"
                },
                "hash": {
                    "type": "string",
                    "description": "Deterministic content hash"
                }
            }
        },
        "rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "typ",
                    "titel",
                    "betrifft",
                    "schweregrad",
                    "scope",
                    "priority"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "typ": {
                        "type": "string",
                        "enum": [
                            "ausschluss",
                            "bedingung",
                            "haeufigkeit",
                            "dokumentation"
                        ]
                    },
                    "titel": {
                        "type": "string"
                    },
                    "beschreibung": {
                        "type": "string"
                    },
                    "betrifft": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Codes affected by this rule (exact or pattern)"
                    },
                    "regel": {
                        "type": "object",
                        "properties": {
                            "operator": {
                                "type": "string",
                                "enum": [
                                    "darf_nicht",
                                    "nur_wenn",
                                    "max_anzahl",
                                    "muss"
                                ]
                            },
                            "bedingung": {
                                "type": "string"
                            },
                            "wert": {
                                "type": "integer"
                            },
                            "zeitraum": {
                                "type": "string"
                            },
                            "bezug": {
                                "type": "string"
                            }
                        }
                    },
                    "schweregrad": {
                        "type": "string",
                        "enum": [
                            "regress",
                            "warnung",
                            "info"
                        ]
                    },
                    "sourceRefs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "anchor": {
                                    "type": "string"
                                },
                                "document": {
                                    "type": "string"
                                },
                                "url": {
                                    "type": "string"
                                },
                                "filePath": {
                                    "type": "string"
                                },
                                "htmlExtractHash": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "scope": {
                        "type": "string",
                        "enum": [
                            "SESSION",
                            "TOOTH",
                            "QUADRANT",
                            "CANAL",
                            "UNKNOWN"
                        ]
                    },
                    "blockWith": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "For ausschluss: codes that conflict"
                    },
                    "autoResolve": {
                        "type": "string",
                        "enum": [
                            "drop_anchor",
                            "drop_blockwith"
                        ],
                        "description": "Auto-resolution policy"
                    },
                    "priority": {
                        "type": "integer",
                        "default": 100
                    }
                }
            }
        }
    }
}